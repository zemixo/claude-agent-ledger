{
  "name": "claude-agent-ledger",
  "version": "0.8.0",
  "description": "See exactly where your Claude Code budget goes — per subagent, per task.",
  "type": "module",
  "bin": {
    "agent-ledger": "bin/agent-ledger.ts"
  },
  "files": [
    "bin",
    "src",
    "BENCHMARKS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run bin/agent-ledger.ts",
    "test": "bun test",
    "build": "bun build bin/agent-ledger.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun run bench/parser.ts",
    "benchmark:check": "bun run bench/parser.ts --profile smoke --check"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "ai-agents",
    "cost-tracking",
    "observability",
    "cli"
  ],
  "author": "Zemixo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemixo/claude-agent-ledger.git"
  },
  "homepage": "https://github.com/zemixo/claude-agent-ledger#readme",
  "bugs": {
    "url": "https://github.com/zemixo/claude-agent-ledger/issues"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-check": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
